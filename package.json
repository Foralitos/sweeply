{
  "name": "sweeply",
  "version": "0.2.0",
  "description": "TUI to find and delete dead weight in your projects (node_modules, .next, venv...) with a git safety traffic light",
  "license": "MIT",
  "author": "Fora (Ángel Iván López Delgado)",
  "homepage": "https://github.com/Foralitos/sweeply#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Foralitos/sweeply.git"
  },
  "bugs": {
    "url": "https://github.com/Foralitos/sweeply/issues"
  },
  "type": "module",
  "bin": {
    "sweeply": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "yarn typecheck && yarn build"
  },
  "keywords": [
    "cli",
    "tui",
    "node_modules",
    "cleanup",
    "disk-space",
    "npkill",
    "monorepo",
    "ink"
  ],
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "esbuild": "^0.28.1"
  }
}
